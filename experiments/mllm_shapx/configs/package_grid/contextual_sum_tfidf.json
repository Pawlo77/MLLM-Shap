{
  "experiment_set_id": "ss_package_test_grid",
  "output_root": "experiments_output",
  "device": "cuda",
  "connector": "hf_text",

  "dataset": {
    "subset": "single_sentence",
    "split": "test",
    "revision": "00cfa818c9f5531e976b418088616875952fef2b",
    "repo_id": "Pawlo77/mllm-shap",
    "use_parquet": false
  },

  "selection": {
    "max_samples": 50,
    "shuffle_seed": 42,
    "start_index": 0,
    "max_prompt_tokens": 10,
    "min_prompt_tokens": 9
  },

  "wandb": {
    "enabled": true,
    "project": "mllm-shap-audio-text",
    "group": "single_sentence",
    "mode": "online",
    "tags": ["single_sentence", "text-only", "grid", "package-tests"]
  },

  "generation": {
    "max_new_tokens": 25,
    "text_temperature": 0.0
  },

  "shap": {
    "mode": "CONTEXTUAL",
    "normalizer": "MinMaxNormalizer",
    "reducer": "SumReducer",
    "similarity": "TfIdfCosineSimilarity"
  },

  "experiments": [
    { "explainer_type": "limited_neyman",  "linear": [1.0], "name": "contextual_sum_tfidf" }
  ]
}
