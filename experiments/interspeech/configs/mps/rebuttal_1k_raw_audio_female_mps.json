{
  "output_root": "experiments/interspeech/outputs/lem_runs",
  "device": "mps",
  "connector": "liquid_audio",
  "dataset": {
    "split": "test",
    "revision": "6c046d6c94a76ddb2bb9e5577fd51e7fb77bb691",
    "repo_id": "Pawlo77/mllm-shap",
    "use_parquet": true,
    "trust_remote_code": true,
    "subset": "single_sentence_1k"
  },
  "selection": {
    "max_samples": 10,
    "shuffle_seed": 42,
    "start_index": 0,
    "max_prompt_tokens": 1000,
    "min_prompt_tokens": 1,
    "balanced_token_counts": [
      6,
      7,
      8,
      9,
      10
    ],
    "samples_per_token_count": 20,
    "allow_partial_token_count_buckets": false
  },
  "wandb": {
    "enabled": false,
    "project": "mllm-shap-audio-text",
    "group": "interspeech_rebuttal",
    "mode": "disabled",
    "tags": [
      "interspeech",
      "rebuttal",
      "single_sentence_1k",
      "audio__female",
      "raw"
    ]
  },
  "generation": {
    "max_new_tokens": 30,
    "text_temperature": 0.0
  },
  "shap": {
    "mode": "CONTEXTUAL",
    "normalizer": "MinMaxNormalizer",
    "reducer": "MeanReducer",
    "similarity": "TfIdfCosineSimilarity"
  },
  "embedding": {
    "model_id": "intfloat/e5-small-v2",
    "revision": "ffb93f3bd4047442299a41ebb6fa998a38507c52",
    "max_length": 64,
    "batch_size": 64,
    "l2_normalize": true,
    "local_files_only": false
  },
  "experiment_set_id": "rebuttal_single_sentence_1k_raw",
  "modality": {
    "input_modality": "audio__female",
    "output_modality": "audio"
  },
  "audio_segmentation": {
    "method": "raw",
    "aligner_device": "cpu"
  },
  "experiments": [
    {
      "explainer_type": "limited_neyman",
      "linear": [
        3.0
      ],
      "name": "audio_female_audio_raw"
    }
  ]
}
